<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="MainWindow"
    Title="Owen MemTool"
    Width="1220"
    Height="790"
    MinWidth="980"
    MinHeight="650"
    WindowStartupLocation="CenterScreen"
    Background="#F4F6F8"
    FontFamily="Aptos, Segoe UI Variable, Segoe UI"
    FontSize="13"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#F4F6F8" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DDE2E7" />
        <SolidColorBrush x:Key="TextBrush" Color="#18212B" />
        <SolidColorBrush x:Key="MutedBrush" Color="#66727F" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#166A75" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#105B64" />
        <SolidColorBrush x:Key="PrimaryTintBrush" Color="#E9F4F4" />
        <SolidColorBrush x:Key="WarningBrush" Color="#A15C09" />
        <SolidColorBrush x:Key="WarningTintBrush" Color="#FFF4DF" />
        <SolidColorBrush x:Key="CriticalBrush" Color="#B93838" />
        <SolidColorBrush x:Key="CriticalTintBrush" Color="#FDECEC" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#267154" />
        <SolidColorBrush x:Key="SuccessTintBrush" Color="#EAF6F0" />

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F5F8F9" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#BAC5CB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EAF0F2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="MinWidth" Value="128" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Margin" Value="10,4" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style x:Key="SegmentButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E8ECEF" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="42" />
            <Setter Property="ColumnHeaderHeight" Value="42" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="#F6F8F9" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="#E2E7EA" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="FindingTemplate">
            <Border
                x:Name="FindingBorder"
                Margin="0,0,8,10"
                Padding="16"
                Background="#FFFFFF"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="34"
                        Height="34"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top"
                        Background="#F0F3F5"
                        CornerRadius="17">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="15"
                            Foreground="#52616D"
                            Text="&#xE946;" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{StaticResource WarningBrush}"
                                Text="{Binding Severity}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource MutedBrush}"
                                Text="{Binding Confidence}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,5,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"
                            Text="{Binding Title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            MaxHeight="42"
                            FontSize="12"
                            Foreground="{StaticResource MutedBrush}"
                            LineHeight="18"
                            Text="{Binding Summary}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter TargetName="FindingBorder" Property="Background" Value="{StaticResource PrimaryTintBrush}" />
                    <Setter TargetName="FindingBorder" Property="BorderBrush" Value="#8CB8BC" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="Owen MemTool" />
                    <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="Windows 메모리 사용과 드라이버 누수 후보를 근거와 함께 진단합니다" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Margin="0,0,12,0" Background="#F6F8F9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="Duration15Button" Style="{StaticResource SegmentButtonStyle}" Content="15초" Tag="15" />
                            <Button x:Name="Duration60Button" Margin="4,0,0,0" Style="{StaticResource SegmentButtonStyle}" Content="1분" Tag="60" />
                            <Button x:Name="Duration300Button" Margin="4,0,0,0" Style="{StaticResource SegmentButtonStyle}" Content="5분" Tag="300" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="StopButton" Margin="0,0,8,0" Style="{StaticResource BaseButtonStyle}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE71A;" />
                            <TextBlock Text="중지" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RunButton" Style="{StaticResource PrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE768;" />
                            <TextBlock Text="진단 시작" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="164" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,14,0,0">
                        <Button x:Name="SummaryNavButton" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="26" FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE9D2;" />
                                <TextBlock Text="진단 요약" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ProcessesNavButton" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="26" FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE716;" />
                                <TextBlock Text="프로세스" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DriversNavButton" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="26" FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE950;" />
                                <TextBlock Text="드라이버" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border Grid.Row="2" Margin="12,0,12,14" Padding="12" Background="#F7F9FA" CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="진단 수준" />
                            <TextBlock x:Name="CapabilityText" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="표준 진단" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="24">
                <Grid x:Name="EmptyState">
                    <StackPanel Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="72" Height="72" HorizontalAlignment="Center" Background="{StaticResource PrimaryTintBrush}" CornerRadius="22">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="30" Foreground="{StaticResource PrimaryBrush}" Text="&#xE9D2;" />
                        </Border>
                        <TextBlock Margin="0,22,0,0" HorizontalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="현재 메모리 상태를 진단하세요" />
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedBrush}" LineHeight="20" Text="프로세스, 커널 풀, GPU, 드라이버를 함께 비교하고&#x0a;관측된 사실과 추정 원인을 구분해 설명합니다." TextAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="LoadingState" Visibility="Collapsed">
                    <StackPanel Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="{StaticResource PrimaryBrush}" Text="&#xE895;" />
                        <TextBlock x:Name="LoadingTitleText" Margin="0,20,0,0" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="메모리 사용을 관측하고 있습니다" />
                        <TextBlock x:Name="LoadingMessageText" Margin="0,8,0,18" HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedBrush}" Text="진단 환경을 확인하는 중입니다." />
                        <ProgressBar x:Name="DiagnosticProgress" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource PrimaryBrush}" Background="#DDE5E7" BorderThickness="0" />
                        <TextBlock x:Name="ProgressText" Margin="0,8,0,0" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="0%" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="SummaryView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="100" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="RiskHero" Grid.Row="0" MinHeight="122" Padding="22" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <Border x:Name="RiskBadge" HorizontalAlignment="Left" Padding="9,4" Background="{StaticResource WarningTintBrush}" CornerRadius="10">
                                    <TextBlock x:Name="RiskLevelText" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Text="REVIEW" />
                                </Border>
                                <TextBlock x:Name="HeadlineText" Margin="0,10,0,0" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="드라이버 또는 프로세스 점검이 필요합니다" />
                                <TextBlock x:Name="CollectedAtText" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="수집 시각" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="32,0,0,0" VerticalAlignment="Center">
                                <Button x:Name="OpenReportButton" Style="{StaticResource BaseButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" />
                                        <TextBlock Text="보고서 열기" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="OpenFolderButton" Margin="0,8,0,0" Style="{StaticResource BaseButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE838;" />
                                        <TextBlock Text="보고서 폴더" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Padding="16" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <StackPanel><TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="물리 메모리 사용" /><TextBlock x:Name="UsedMemoryText" Margin="0,8,0,0" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="-" /></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="16" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <StackPanel><TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="사용 가능" /><TextBlock x:Name="AvailableMemoryText" Margin="0,8,0,0" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="-" /></StackPanel>
                        </Border>
                        <Border Grid.Column="4" Padding="16" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <StackPanel><TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="커널 풀" /><TextBlock x:Name="KernelPoolText" Margin="0,8,0,0" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="-" /></StackPanel>
                        </Border>
                        <Border Grid.Column="6" Padding="16" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <StackPanel><TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="커밋" /><TextBlock x:Name="CommitText" Margin="0,8,0,0" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="-" /></StackPanel>
                        </Border>
                        <Border Grid.Column="8" Padding="16" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <StackPanel><TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="Interrupt / DPC" /><TextBlock x:Name="InterruptText" Margin="0,8,0,0" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="-" /></StackPanel>
                        </Border>
                        <Border Grid.Column="10" Padding="16" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <StackPanel><TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="프로세스 핸들" /><TextBlock x:Name="HandleText" Margin="0,8,0,0" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="-" /></StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="추정 원인" />
                                <TextBlock x:Name="FindingCountText" Margin="8,1,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="0개" />
                            </DockPanel>
                            <ListBox x:Name="FindingList" Grid.Row="2" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource FindingTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </Grid>
                        <Border Grid.Column="2" Padding="20" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="선택한 원인" />
                                    <TextBlock x:Name="FindingTitleText" Margin="0,8,0,0" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="원인을 선택하세요" TextWrapping="Wrap" />
                                    <TextBlock x:Name="FindingSummaryText" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" LineHeight="19" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,20,0,8" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="근거" />
                                    <ItemsControl x:Name="EvidenceList">
                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,0,0,7" FontSize="12" Foreground="#45515C" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="RelatedDriversHeading" Margin="0,16,0,8" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="관련 드라이버와 연관 앱" Visibility="Collapsed" />
                                    <ItemsControl x:Name="RelatedDriverList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#26333E" Text="{Binding NameLine}" TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding ProductLine}" TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding PathLine}" TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource PrimaryBrush}" Text="{Binding AppsLine}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="0,16,0,8" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="다음 단계" />
                                    <ItemsControl x:Name="NextStepsList">
                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,0,0,7" FontSize="12" Foreground="#45515C" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="ProcessesView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="프로세스 메모리와 핸들" />
                        <TextBlock x:Name="ProcessSummaryText" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="프로세스별 메모리와 진단 구간의 핸들 변화를 비교합니다." />
                    </StackPanel>
                    <DataGrid x:Name="ProcessGrid" Grid.Row="2" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="2*" Header="프로세스" Binding="{Binding Name}" />
                            <DataGridTextColumn Width="70" Header="개수" Binding="{Binding Count}" />
                            <DataGridTextColumn Width="*" Header="작업 집합" Binding="{Binding WorkingSetDisplay}" />
                            <DataGridTextColumn Width="*" Header="사설 메모리" Binding="{Binding PrivateDisplay}" />
                            <DataGridTextColumn Width="*" Header="핸들" Binding="{Binding HandleCountDisplay}" />
                            <DataGridTextColumn Width="*" Header="핸들 변화" Binding="{Binding HandleDeltaDisplay}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid x:Name="DriversView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="실행 중인 분석 대상 드라이버" />
                        <TextBlock x:Name="DriverSummaryText" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="파일시스템, 그래픽, 네트워크 드라이버의 제품과 버전을 확인합니다." />
                    </StackPanel>
                    <DataGrid x:Name="DriverGrid" Grid.Row="2" AlternationCount="2" FrozenColumnCount="1" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="130" Header="드라이버" Binding="{Binding Name}" />
                            <DataGridTextColumn Width="220" Header="벤더" Binding="{Binding Company}" />
                            <DataGridTextColumn Width="260" Header="제품" Binding="{Binding ProductName}" />
                            <DataGridTextColumn Width="280" Header="버전" Binding="{Binding FileVersion}" />
                            <DataGridTextColumn Width="100" Header="서명" Binding="{Binding SignatureStatus}" />
                            <DataGridTextColumn Width="320" Header="연관 앱(추정)" Binding="{Binding AssociatedApps}" />
                            <DataGridTextColumn Width="520" Header="드라이버 경로" Binding="{Binding Path}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#EDF1F3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="준비됨" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="관측 · 추정 · 확정을 구분합니다" />
            </Grid>
        </Border>
    </Grid>
</Window>